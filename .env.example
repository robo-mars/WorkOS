# Copy to .env for Docker Compose. Local scripts supply explicit demo-only defaults.
DEMO_MODE=true
LOGIN_CODE=workplace-demo
SESSION_SECRET=local-demo-session-secret-change-before-deploying
SERVICE_TOKEN=local-demo-service-token
POSTGRES_PASSWORD=local-demo-postgres-password
WEB_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
PLANNER_MODE=demo
# Set PLANNER_MODE=llm and configure a Chat Completions compatible provider.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=
